// ============================================================================
// ⚠️  修改本文件后，务必编写数据库迁移脚本！
//
// 流程：
//   1. 修改本文件（schema.prisma）
//   2. cd backend-ts && npm run db:migrate:gen -- --name <迁移名称>
//      → 自动生成增量迁移 SQL + TS 模板（给老用户升级）
//      → 自动重新生成 baseline.sql（给全新安装）
//   3. 在 src/common/database/migrations/index.ts 注册迁移
//   4. 如默认数据有变，更新 migrations/seed-data.ts
//   5. 重启应用，MigrationRunner 自动执行
//
// 详见 docs/DATABASE_MIGRATION.md
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SessionGroup {
  // 已冻结：会话分组权威来源改为 sessions/_groups.json，本表仅供一次性导出与回滚
  id        String    @id @default(cuid())
  name      String
  userId    String    @map("user_id")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sessions  Session[]

  @@index([userId])
  @@map("session_group")
}

model Session {
  // 已冻结：会话元信息权威来源改为 <sessions根>/<sessionId>/meta.json（分组走 _groups.json），
  // 本表仅供一次性导出与回滚，运行时不读写，上线前删除
  id            String                @id @default(cuid())
  title         String?
  userId        String                @map("user_id")
  avatarUrl     String?               @map("avatar_url")
  description   String?
  modelId       String?               @map("model_id")
  characterId   String?               @map("character_id")
  groupId       String?               @map("group_id")
  settings      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  lastActiveAt  DateTime?             @map("last_active_at")
  sessionType   String?               @default("web") @map("session_type")
  archived      Boolean               @default(false)
  botId         String?               @map("bot_id")
  platform      String?
  externalId    String?               @map("external_id")
  workspacePath String?               @map("workspace_path")
  parentId      String?               @map("parent_id")
  // 子代理冻结标记（sub_agent_closed 语义修复）：NULL=活跃；非空=已结束仅供回放
  closedAt      DateTime?             @map("closed_at")
  closeReason   String?               @map("close_reason")
  memories      Memory[]
  messages      Message[]
  user          User                  @relation(fields: [userId], references: [id])
  group         SessionGroup?         @relation(fields: [groupId], references: [id])
  // characterId 是文件侧角色 id（= agents/<id> 目录名），权威来源 agents/<id>/AGENT.md；
  // 不建 DB 关系——character 表仅为还原快照，上线前删除
  // modelId 是文件侧模型 id（`{实例id}:{模型名}`），权威来源 providers/*.yaml；
  // 不建 DB 关系——model/model_provider 表仅为还原快照，上线前删除
  parent        Session?              @relation("SessionHierarchy", fields: [parentId], references: [id])
  children      Session[]             @relation("SessionHierarchy")

  @@index([userId])
  @@index([sessionType])
  @@index([botId])
  @@index([platform])
  @@index([externalId])
  @@index([botId, externalId])
  @@index([groupId])
  @@index([parentId])
  @@map("session")
}

model Message {
  id               String           @id @default(cuid())
  sessionId        String           @map("session_id")
  role             String
  parentId         String?          @map("parent_id")
  currentTurnsId   String?          @map("current_turns_id")
  currentVersionId String?          @map("current_version_id")
  metadata         Json?            @map("meta_data")
  totalDurationMs  Int?             @map("total_duration_ms")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // parent           Message?         @relation("MessageThread", fields: [parentId], references: [id])
  // children         Message[]        @relation("MessageThread")
  contents         MessageContent[]

  @@index([sessionId])
  @@index([parentId])
  // @@index([currentTurnsId])
  @@index([currentVersionId])
  @@map("message")
}

model MessageContent {
  id               String   @id @default(cuid())
  messageId        String   @map("message_id")
  turnsId          String   @map("turns_id")
  role             String?
  content          String
  reasoningContent String?  @map("reasoning_content")
  additionalKwargs Json?    @map("additional_kwargs")
  metadata         Json?    @map("meta_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  files            File[]

  @@index([messageId])
  // @@index([turnsId])
  @@map("message_content")
}

model ModelProvider {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  provider   String
  protocol   String?
  apiUrl     String   @map("api_url")
  apiKey     String?  @map("api_key")
  avatarUrl  String?  @map("avatar_url")
  attributes Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  models     Model[]

  // 注意：删除时关联 Model 被级联删除，但其他表对 Model 的引用ID保留（悬空引用设计）。未来如需自动清理，需修改 Session/Character/KnowledgeBase 的 onDelete 策略
  @@map("model_provider")
}

model Model {
  id             String          @id @default(cuid())
  name           String?
  providerId     String          @map("provider_id")
  modelName      String          @map("model_name")
  modelType      String          @map("model_type")
  config         Json?           @map("config")
  isFavorite     Boolean         @default(false) @map("is_favorite")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  // 注意：删除 ModelProvider 时，关联的 Model 被级联删除
  provider       ModelProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("model")
}

model User {
  // 已冻结：账户权威来源改为 <SETTINGS_DIR>/account.json（含可选密码），
  // 本表仅供回滚快照，运行时不读写，上线前删除。
  // 注意：单账户模型下 role/parentId 已无意义（多账户体系已移除）
  id             String          @id @default(cuid())
  role           String?
  avatarUrl      String?         @map("avatar_url")
  wallpaperUrl   String?         @map("wallpaper_url")
  parentId       String?         @map("parent_id")
  nickname       String?
  username       String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  botInstances   BotInstance[]
  characters     Character[]
  knowledgeBases KnowledgeBase[]
  sessions       Session[]
  settings       UserSetting?

  @@map("user")
}

/// 已冻结（死模型）：全代码库零引用、无文件存储对应物；仅保留表结构作迁移期存档，不删表
model CharacterGroup {
  id         String      @id @default(cuid())
  name       String
  userId     String      @map("user_id")
  sortOrder  Int         @default(0) @map("sort_order")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  characters Character[]

  // 已冻结：角色分组功能已移除（角色不再有分组概念），本表仅供回滚，上线前删除
  @@map("character_group")
}

model Character {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  title       String
  description String?
  avatarUrl   String?         @map("avatar_url")
  isPublic    Boolean         @default(false) @map("is_public")
  modelId     String?         @map("model_id")
  groupId     String?         @map("group_id")
  settings    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  group       CharacterGroup? @relation(fields: [groupId], references: [id])
  // modelId 是文件侧模型 id，权威来源 providers/*.yaml（同 Session.modelId）
  user        User            @relation(fields: [userId], references: [id])

  // 已冻结：角色/智能体定义的权威来源改为 agents/<id>/AGENT.md（含名称/提示词/设置），
  // 本表仅供一次性导出读取与回滚，运行时不读写，上线前删除
  @@map("character")
}

model KnowledgeBase {
  // 已冻结：知识库配置权威来源改为 <KB根>/<kbId>/kb.json，本表仅供一次性导出与回滚
  id               String   @id @default(cuid())
  name             String
  description      String?
  userId           String   @map("user_id")
  embeddingModelId String   @map("embedding_model_id")
  chunkMaxSize     Int      @default(1000) @map("chunk_max_size")
  chunkOverlapSize Int      @default(100) @map("chunk_overlap_size")
  chunkMinSize     Int      @default(50) @map("chunk_min_size")
  isActive         Boolean  @default(true) @map("is_active")
  isPublic         Boolean  @default(false) @map("is_public")
  metadataConfig   Json?    @map("metadata_config")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  files            KBFile[]
  // embeddingModelId 是文件侧模型 id，权威来源 providers/*.yaml（同 Session.modelId）
  user             User     @relation(fields: [userId], references: [id])

  @@map("knowledge_base")
}

model KBFile {
  // 已冻结：文件元信息权威来源改为 <KB根>/<kbId>/<itemId>/file.json，本表仅供导出与回滚
  id                 String        @id @default(cuid())
  knowledgeBaseId    String        @map("knowledge_base_id")
  fileName           String        @map("file_name")
  displayName        String        @map("display_name")
  fileSize           Int           @map("file_size")
  fileType           String        @map("file_type")
  fileExtension      String        @map("file_extension")
  contentHash        String        @map("content_hash")
  filePath           String?       @map("file_path")
  content            String?
  relativePath       String?       @map("relative_path")
  parentFolderId     String?       @map("parent_folder_id")
  isDirectory        Boolean       @default(false) @map("is_directory")
  processingStatus   String        @default("pending") @map("processing_status")
  progressPercentage Int           @default(0) @map("progress_percentage")
  currentStep        String?       @map("current_step")
  errorMessage       String?       @map("error_message")
  totalChunks        Int           @default(0) @map("total_chunks")
  totalTokens        Int           @default(0) @map("total_tokens")
  uploadedAt         DateTime      @default(now()) @map("uploaded_at")
  processedAt        DateTime?     @map("processed_at")
  chunks             KBChunk[]
  knowledgeBase      KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  parent             KBFile?       @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  children           KBFile[]      @relation("FolderHierarchy")

  @@index([knowledgeBaseId])
  @@index([contentHash])
  @@index([processingStatus])
  @@index([parentFolderId])
  @@index([knowledgeBaseId, relativePath])
  @@map("kb_file")
}

model KBChunk {
  // 已冻结：分块正本改为 <KB根>/<kbId>/<fileId>/chunks.jsonl；本表仅 JSONL 缺失时兼容期 fallback
  id                  String   @id @default(cuid())
  fileId              String   @map("file_id")
  knowledgeBaseId     String   @map("knowledge_base_id")
  content             String
  chunkIndex          Int      @map("chunk_index")
  vectorId            String?  @map("vector_id")
  embeddingDimensions Int?     @map("embedding_dimensions")
  tokenCount          Int      @default(0) @map("token_count")
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at")
  file                KBFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([knowledgeBaseId])
  @@index([vectorId])
  @@map("kb_chunk")
}

model Memory {
  // 已冻结：运行时记忆走 <workspace>/.guada/memory/*.md，本表全代码库零访问（历史遗留）
  id         String    @id @default(cuid())
  sessionId  String    @map("session_id")
  content    String
  category   String    @default("long_term")
  memoryType String    @default("factual") @map("memory_type")
  importance Int       @default(5)
  tags       String?
  metadata   Json?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([category])
  @@index([memoryType])
  @@map("memory")
}

model File {
  id            String   @id @default(cuid())
  fileName      String   @map("file_name")
  displayName   String   @map("display_name")
  fileSize      Int      @map("file_size")
  fileType      String   @map("file_type")
  fileExtension String   @map("file_extension")
  content       String?
  url           String?
  previewUrl    String?  @map("preview_url")
  contentHash   String   @map("content_hash")
  sessionId     String?  @map("session_id")
  contentId     String?  @map("content_id")
  isPublic      Boolean  @default(false) @map("is_public")
  fileMetadata  Json?    @map("file_metadata")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  messageContent MessageContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([contentHash])
  @@index([sessionId])
  @@index([contentId])
  @@map("file")
}

model McpServer {
  // 已冻结：MCP 服务器配置权威来源改为 <MCP根>/<id>.yaml（工具缓存 <id>.tools.json），
  // 本表仅供一次性导出读取与回滚（安装/升级时仍要读它做数据迁移），运行时不读写。
  // 注意：id 被角色设置里的 `mcp_<id>` 工具包过滤引用，导出时不可重键。
  id          String   @id @default(cuid())
  name        String
  url         String?
  type        String?
  description String?
  headers     Json?
  command     String?
  args        Json?
  env         Json?
  cwd         String?
  tools       Json?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("mcp_server")
}


model UserSetting {
  // 已冻结：全局设置走 <SETTINGS_DIR>/<group>.json，本表全代码库零访问（历史遗留）
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_setting")
}

model BotInstance {
  // 已冻结：机器人实例权威来源改为 bots/<botId>.yaml，本表仅供一次性导出与回滚
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  platform           String
  name               String
  enabled            Boolean   @default(true)
  platformConfig     Json      @map("platform_config")
  reconnectEnabled   Boolean   @default(true) @map("reconnect_enabled")
  maxRetries         Int       @default(5) @map("max_retries")
  retryInterval      Int       @default(5000) @map("retry_interval")
  defaultCharacterId String    @map("default_character_id")
  defaultModelId       String?   @map("default_model_id")
  defaultThinkingEffort String?   @map("default_thinking_effort")
  status               String    @default("stopped")
  lastStartedAt      DateTime? @map("last_started_at")
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  additionalKwargs   Json?     @map("additional_kwargs")
  user               User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@map("bot_instance")
}
