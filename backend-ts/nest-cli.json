{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "common/utils/tokenizers/**/*",
        "outDir": "dist"
      },
      {
        "include": "common/services/command-policy/defaults/*.yaml",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
