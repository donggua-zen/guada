# ========================================
# GuaDa AI 环境变量配置
# ========================================
#
# 重要提示：
# - Web 环境：直接修改本文件中的配置即可生效
# - Electron 环境：main.ts 中会动态传入环境变量，优先级高于本文件
#   如需修改 Electron 环境的配置，请编辑 electron/main.ts 第 340-357 行
# ========================================

# 知识库存储根目录（可选）
# 布局：<KB_DATA_DIR>/<kbId>/{kb.json, kb.db, raw/}——每库一个自包含目录
# 解析优先级：kbStorageRoot 设置（SettingsService）→ KB_DATA_DIR → USERDATA_DIR/data/kb → ./data/kb
# 条目/分块/向量都在各库自己的 kb.db 里；原件副本在 <kbId>/raw/（不再用共享上传目录）
# 说明见 docs/design/kb-storage.md
#KB_DATA_DIR=./data/kb

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-2026"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=3000
NODE_ENV=development

# 应用基础 URL（用于生成完整的资源 URL，如图片、文件等）
# 
# 配置说明：
# - Electron 生产环境：设置为 __auto__，系统会在启动时自动检测实际端口并动态设置
# - Electron 开发环境：设置为 http://localhost:3000
# - Web 生产环境：设置为域名或 IP 地址（例如: https://api.example.com 或 http://192.168.1.100:3000）
# - Web 开发环境：可以留空，使用相对路径
#
# 示例：
#   BASE_URL=__auto__                            # Electron 生产环境（自动检测端口）
#   BASE_URL=https://api.yourdomain.com          # Web 生产环境使用域名
#   BASE_URL=http://192.168.1.100:3000           # 局域网使用 IP
#   BASE_URL=                                    # Web 开发环境留空（相对路径）
BASE_URL=http://localhost:3000

# 静态资源配置
STATIC_DIR=./static
STATIC_URL=/static

# 上传文件配置（完全独立于 STATIC_DIR/STATIC_URL）
# UPLOAD_ROOT_DIR: 上传文件的物理存储路径
# UPLOAD_URL_PREFIX: 上传文件的 URL 访问前缀
# 
# 开发环境示例：使用项目内的目录
UPLOAD_ROOT_DIR=./data/uploads
UPLOAD_URL_PREFIX=/uploads
#
# 生产环境示例（Electron）：使用用户数据区
# UPLOAD_ROOT_DIR=C:/Users/xxx/AppData/Roaming/GuaDa/file_stores
# UPLOAD_URL_PREFIX=/uploads

# CHAT_UPLOAD_MAX_MB: 聊天附件单文件上限（MB，默认 100，范围 1..4096）
# 由 multer 在进入 handler 之前按同一数值拒绝，避免无效请求把内存吃掉。
# CHAT_UPLOAD_MAX_MB=100

# 聊天附件的落点（2026-09 起，见 FileRef.refType）：
# - 图片：落「会话数据目录」<sessionsBase>/<sessionId>/images（≤1024px JPEG 原图）
#   + previews/（缩略图），url 自包含（sessions/<id>/...）——删除/清空会话时整目录
#   rm -rf 自动清掉，无孤儿；展示走鉴权取图端点，不再经过 /uploads 静态挂载
# - 其余：落「会话工作目录」下的附件子目录，模型拿到的是工作目录相对路径引用，
#   需要内容时自行按扩展名选工具（read / document.doc_parse）
#   子目录名默认 uploads，可在设置中心改（system.chatUploadSubdir）
# 默认布局下的形态示例：
#   workspaces/WORK-2026-09-15-Ab3x/
#   ├── uploads/20260915/季度报告_1430_ab12cd.pdf   ← Web 上传的普通文件
#   ├── files/飞书附件.xlsx                          ← bot-gateway 下载的渠道附件
#   └── .guada/                                      ← todo / tools_output / git
#   sessions/<sessionId>/
#   ├── seg-0000.jsonl / meta.json / workflows/     ← 会话记录与伴生产物
#   ├── images/20260915/照片_1430_ab12cd.jpg         ← 图片附件（随会话删除）
#   └── previews/20260915/照片_1430_ab12cd.jpg       ← 缩略图

# SESSION_DATA_DIR: 会话 JSONL 数据根目录（可选）
# 解析优先级：
#   1. SESSION_DATA_DIR（显式）
#   2. USERDATA_DIR（Electron 数据根目录，即 ~/.guada/）→ 存 <USERDATA_DIR>/sessions
#   3. UPLOAD_ROOT_DIR 父目录（<dataHome>/file_stores → <dataHome>）
#   4. 默认 ./data/sessions
# Electron 实际布局（main.ts computeDataPaths）：
#   ~/.guada/
#   ├── data/           # 数据库/向量库
#   ├── file_stores/    # 头像/壁纸等全局上传（UPLOAD_ROOT_DIR）
#   ├── workspaces/     # 会话工作区
#   └── sessions/       # 会话数据：JSONL + meta + workflows + 图片附件
# 显式设置示例：
# SESSION_DATA_DIR=./data
# SESSION_DATA_DIR=C:/Users/xxx/.guada



# Token Cache 配置（可选）
# Tokenizer 分词结果缓存配置，用于优化重复文本的 Token 计算性能
# TOKEN_CACHE_MAX_ENTRIES: 最大缓存条目数（默认 10000）
TOKEN_CACHE_MAX_ENTRIES=10000
# TOKEN_CACHE_MAX_MEMORY_MB: 最大内存占用 MB（默认 50）
TOKEN_CACHE_MAX_MEMORY_MB=50
# TOKEN_CACHE_TTL_MS: TTL 过期时间毫秒（默认 1800000 = 30分钟）
TOKEN_CACHE_TTL_MS=1800000
# TOKEN_CACHE_CLEANUP_INTERVAL_MS: 定期清理间隔毫秒（默认 300000 = 5分钟）
TOKEN_CACHE_CLEANUP_INTERVAL_MS=300000

# API 请求耗时统计（可选）
# 设置为 true/1/yes 开启，其他值或留空则关闭
ENABLE_REQUEST_TIMING=false

# ========================================
# Electron 环境变量覆盖说明
# ========================================
#
# Electron 应用在启动后端进程时，会通过 process.env 动态传入环境变量。
# 这些变量的优先级高于本 .env 文件中的配置。
#
# 如需修改 Electron 环境的配置，请编辑以下文件：
#   electron/main.ts (第 340-357 行)
#
# Electron 中设置的环境变量包括：
#   - BASE_URL: '__auto__' (自动检测端口)
#   - 知识库：kbStorageRoot 设置 > KB_DATA_DIR > USERDATA_DIR/data/kb
#   - USERDATA_DIR: dataHome (知识库分块 JSONL 自动落在 <dataHome>/data/kb)
#   - STATIC_DIR: staticDir (应用资源目录)
#   - UPLOAD_ROOT_DIR: uploadDir (用户数据区)
#   - SETTINGS_DIR: userDataPath (用户数据区)
#   - LOGS_DIR: logsDir (用户数据区)
#   - SKILLS_DIR: skillsDir (用户数据区)
#   - WORKSPACE_BASE_DIR: workspaceDir (用户数据区)
#   - ELECTRON_APP: 'true'
#   - BROWSER_BRIDGE_MODE: 'ipc'
#
# Web 环境不受影响，直接使用本文件的配置。
# ========================================
