# 评测本地配置（**不入库**，见 .gitignore）
# 复制成 eval/.env.local 并填自己的值；eval/retest.sh 与 eval/watch.sh 会自动加载。
#
#   cp eval/.env.local.example eval/.env.local

# 模型：<providerId>:<modelName>
# providerId = ~/.guada-dev/providers/<文件名>.yaml 里的 id 字段
GUADA_MODEL=

# 后端基址（一般不用改）
GUADA_BASE_URL=http://127.0.0.1:3000/api/v1

# 智能体 id（= ~/.guada-dev/agents/ 下的目录名）
GUADA_AGENT_ID=code-analyst

# 前端地址（watch.sh 用它拼会话直达链接）
GUADA_FRONTEND_URL=http://localhost:5173

# adapter 单轮墙钟上限（秒）；迭代用 300，正式跑分放开
GUADA_TIMEOUT=300

# 结果目录
GUADA_JOBS_DIR=D:/AI/guada-eval/jobs
