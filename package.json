{
  "name": "guada",
  "version": "1.0.6",
  "description": "GuaDa Application with Web and Electron support",
  "private": true,
  "main": "electron/dist/main.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "dev:web": "pnpm --dir frontend run dev",
    "dev:backend": "pnpm --dir backend-ts run start:dev",
    "dev:backend:electron": "pnpm --dir backend-ts run start:dev:electron",
    "dev:electron": "pnpm run build:electron-ts && concurrently \"pnpm --dir frontend run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development GUADA_DEV_DATA=1 electron .\"",
    "dev:prod-debug": "pnpm run build:electron-ts && cross-env ELECTRON=true pnpm --dir frontend run build && cross-env GUADA_PROD_DEBUG=1 USE_STATIC_FRONTEND=true DEBUG_MODE=true PORT=0 NODE_ENV=development electron .",
    "build:web": "pnpm --dir frontend run build",
    "lint": "pnpm --dir frontend run lint",
    "build:backend": "pnpm --dir backend-ts run build",
    "build:frontend": "pnpm --dir frontend run build",
    "build:electron-ts": "cd electron && tsc",
    "rebuild:backend-native": "node scripts/rebuild-native.js",
    "patch:watcher": "node scripts/patch-parcel-watcher.mjs",
    "rebuild:backend-native:electron": "node scripts/rebuild-native-electron.js",
    "optimize:electron-deps": "node scripts/optimize-electron-deps.js",
    "optimize:electron-deps:mac": "cross-env SHARP_TARGET_PLATFORMS=darwin node scripts/optimize-electron-deps.js",
    "optimize:electron-deps:linux": "cross-env SHARP_TARGET_PLATFORMS=linux node scripts/optimize-electron-deps.js",
    "optimize:electron-deps:win-linux": "cross-env SHARP_TARGET_PLATFORMS=win32,linux node scripts/optimize-electron-deps.js",
    "optimize:electron-deps:all": "cross-env SHARP_TARGET_PLATFORMS=win32,linux,darwin node scripts/optimize-electron-deps.js",
    "compare:deps-size": "node scripts/compare-node-modules-size.js",
    "analyze:modules": "node scripts/analyze-module-size.js",
    "verify:electron-setup": "node scripts/verify-electron-setup.js",
    "verify:asar": "node scripts/verify-asar-layout.js",
    "verify:packaged": "node scripts/verify-packaged-backend.js",
    "test:browser-snapshot:unit": "cd electron && tsc && cd .. && node scripts/test-accessibility-snapshot.js",
    "test:browser-snapshot:fixture": "cd electron && tsc && cd .. && electron scripts/test-browser-snapshot-electron.js",
    "test:browser-snapshot:bilibili": "cd electron && tsc && cd .. && electron scripts/test-browser-snapshot-electron.js https://www.bilibili.com/",
    "test:webview-navigation-crash": "node --test --test-concurrency=1 scripts/test-webview-navigation-crash.js",
    "build:electron:clean": "node scripts/clean-release.js",
    "build:electron:pre": "pnpm run build:electron:clean && pnpm run build:electron-ts",
    "build:electron:backend": "node scripts/build-electron-backend.js",
    "build:electron:frontend": "cross-env ELECTRON=true pnpm --dir frontend run build",
    "build:electron:package": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ WIN_CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON=true electron-builder",
    "build:electron:package:mac": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ WIN_CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON=true electron-builder --mac",
    "build:electron:package:mac:sign": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ node scripts/package-mac-signed.js",
    "build:electron:mac:sign": "pnpm run build:electron:pre && concurrently --names BACKEND,FRONTEND \"pnpm run build:electron:backend\" \"pnpm run build:electron:frontend\" && pnpm run build:electron:package:mac:sign",
    "build:electron:package:dir": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ WIN_CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON=true electron-builder --dir",
    "build:electron": "pnpm run build:electron:pre && concurrently --names BACKEND,FRONTEND \"pnpm run build:electron:backend\" \"pnpm run build:electron:frontend\" && pnpm run build:electron:package",
    "build:electron:mac": "pnpm run build:electron:pre && concurrently --names BACKEND,FRONTEND \"pnpm run build:electron:backend\" \"pnpm run build:electron:frontend\" && pnpm run build:electron:package:mac",
    "build:electron:dir": "pnpm run build:electron-ts && concurrently --names BACKEND,FRONTEND \"pnpm run build:electron:backend\" \"pnpm run build:electron:frontend\" && pnpm run build:electron:package:dir",
    "postinstall": "pnpm --dir backend-ts install && pnpm --dir frontend install && node scripts/ensure-pty-spawn-helper.js --warn-only"
  },
  "keywords": [
    "ai",
    "chat",
    "electron",
    "vue"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^41.10.3",
    "electron-builder": "^24.13.3",
    "glob": "^10.5.0",
    "rcedit": "^5.0.1",
    "typescript": "^6.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.guada.app",
    "productName": "GuaDa",
    "npmRebuild": false,
    "asar": {
      "smartUnpack": true
    },
    "includeSubNodeModules": true,
    "asarUnpack": [
      "backend-ts/node_modules_production/node_modules/better-sqlite3/**",
      "backend-ts/node_modules_production/node_modules/node-pty/**",
      "backend-ts/node_modules_production/node_modules/sqlite-vec-*/**",
      "backend-ts/node_modules_production/node_modules/@parcel/watcher-win32-x64/**",
      "backend-ts/node_modules_production/node_modules/@parcel/watcher-darwin-*/**",
      "backend-ts/node_modules_production/node_modules/@img/sharp-*/**",
      "backend-ts/node_modules_production/node_modules/@napi-rs/canvas-*/**",
      "backend-ts/node_modules_production/node_modules/@node-rs/jieba-*/**"
    ],
    "afterPack": "scripts/after-pack-handler.js",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/dist/**/*",
      "frontend/dist/**/*",
      "build-resources/icon.ico",
      {
        "from": "backend-ts/node_modules_production/node_modules",
        "to": "backend-ts/node_modules",
        "filter": [
          "**/*",
          "!**/.cache/**",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/*.ts",
          "!**/*.map",
          "!**/*.md",
          "!**/CHANGELOG*",
          "!**/LICENSE*",
          "!**/AUTHORS*",
          "!**/docs/**",
          "!**/doc/**",
          "!**/example/**",
          "!**/examples/**",
          "!**/demo/**",
          "!**/*.d.ts",
          "!**/.github/**",
          "!**/history/**",
          "!**/man/**"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "backend-ts/dist",
        "to": "backend-ts/dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "backend-ts/static",
        "to": "backend-ts/static",
        "filter": [
          "**/*",
          "!**/file_stores/**/*"
        ]
      },
      {
        "from": "backend-ts/bundled-skills",
        "to": "backend-ts/bundled-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend-ts/bundled-agents",
        "to": "backend-ts/bundled-agents",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend-ts/bundled-providers",
        "to": "backend-ts/bundled-providers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources",
        "to": "build-resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins/guada-themes",
        "to": "plugins/guada-themes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "GuaDa-Setup-${version}.${ext}",
      "sign": null,
      "signDlls": false,
      "forceCodeSigning": false,
      "extraResources": [
        {
          "from": "vc-runtime",
          "to": "vc-runtime",
          "filter": [
            "**/*.dll"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "用于访问局域网内的设备：终端里的 ping / ssh / curl 等命令需要本地网络权限，否则只能访问外网、连不上 NAS 或开发板。"
      },
      "extraResources": [
        {
          "from": "sandbox/sandbox-macos-arm64",
          "to": "sandbox/sandbox-macos-arm64"
        },
        {
          "from": "sandbox/sandbox-macos-x64",
          "to": "sandbox/sandbox-macos-x64"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "sandbox/sandbox",
          "to": "sandbox/sandbox"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GuaDa",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "your-username",
        "repo": "guada"
      },
      {
        "provider": "generic",
        "url": "https://ai.dingd.cn/updates/${os}"
      }
    ]
  },
  "dependencies": {
    "builder-util-runtime": "9.2.10",
    "electron-log": "^5.4.3",
    "electron-updater": "6.3.9",
    "fs-extra": "^10.1.0",
    "js-yaml": "^4.1.1",
    "lazy-val": "^1.0.5",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isequal": "^4.5.0",
    "semver": "^7.8.5",
    "tiny-typed-emitter": "^2.1.0"
  }
}
